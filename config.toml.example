# credproxy global configuration
# Copy to ~/.config/credproxy/config.toml and fill in your values
# Project-specific overrides go in .credproxy.toml at the project root

# Global env vars (always injected, unless overridden by profile)
[env]
TERM = "xterm-256color"

# Global host config (used when no profile is active)
[hosts."api.github.com"]
credential = "op://Personal/github-pat/token"

[hosts."api.stripe.com"]
credential = "op://Personal/stripe-default/key"

# Profile definitions
# Select with: credproxy --profile staging <command>

[profiles.staging.hosts."api.stripe.com"]
credential = "op://Personal/stripe-test/key"

[profiles.staging.env]
RAILS_ENV = "staging"
PORT = "3000"

[profiles.production.hosts."api.stripe.com"]
credential = "op://Personal/stripe-live/key"

[profiles.production.env]
RAILS_ENV = "production"
PORT = "443"

# Database credential isolation (optional)
# Each entry starts a local pooler at session start (pgbouncer for postgres,
# ProxySQL for mysql); the wrapped child gets <env> pointing at 127.0.0.1
# with a random per-session password. The real password never reaches the
# child. Requires the pgbouncer / proxysql binaries on PATH (or *_path
# overrides below).
#
# [databases.mydb]
# engine = "postgres"              # or "mysql"
# host = "db.example.com"
# port = 5432
# user = "app_user"
# password = "op://Private/mydb/password"   # op:// URI or literal
# database = "appdb"
# params = "sslmode=require"       # optional, engine-interpreted
# env = "DATABASE_URL"             # env var injected into the wrapped child
#
# pgbouncer_path = "/usr/local/bin/pgbouncer"   # optional binary overrides
# proxysql_path = "/usr/local/bin/proxysql"
